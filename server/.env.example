# Existing MongoDB. The app appends /chat-app when the URI has no database path.
MONGODB_URI=<EXISTING_MONGODB_URI>
JWT_SECRET=<JWT_SECRET>
PORT=5000

# Cloudinary already stores profile photos, images, and voice notes.
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# MySQL owns QR tokens, device sessions, and abuse reports.
MYSQL_HOST=<MYSQL_HOST>
MYSQL_PORT=3306
MYSQL_USER=<MYSQL_USER>
MYSQL_PASSWORD=<MYSQL_PASSWORD>
MYSQL_DATABASE=<MYSQL_DATABASE>

# Gemini stays on the server. Do not create a VITE_ copy of this key.
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=<GEMINI_MODEL>

# Optional. Without it, cleanup and transcription run inside this process.
REDIS_URL=<REDIS_CONNECTION_URL>

# Optional comma-separated origins. Unset keeps local development open.
FRONTEND_URL=<FRONTEND_URL>

# Comma-separated emails that can review reports. There is no admin role in the user record.
ADMIN_EMAILS=<ADMIN_EMAILS>

# Optional windows, in milliseconds.
MESSAGE_EDIT_WINDOW_MS=900000
DELETE_EVERYONE_WINDOW_MS=3600000

# Documented and unused. Files stay on Cloudinary. Email is not sent.
STORAGE_PROVIDER=<STORAGE_PROVIDER>
STORAGE_BUCKET=<STORAGE_BUCKET>
STORAGE_REGION=<STORAGE_REGION>
STORAGE_ACCESS_KEY=<STORAGE_ACCESS_KEY>
STORAGE_SECRET_KEY=<STORAGE_SECRET_KEY>
EMAIL_API_KEY=<EMAIL_PROVIDER_API_KEY>
EMAIL_FROM=<VERIFIED_SENDER_EMAIL>
BACKEND_URL=<BACKEND_URL>
